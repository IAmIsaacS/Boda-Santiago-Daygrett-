---
import heroImage from '../assets/hero.jpeg';
---

<!-- 04. PRIMERA SECCIÓN — PORTADA FOTOGRÁFICA (HERO 100vh) -->
<section class="relative w-full h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-stone-900" id="hero">
  <!-- Fotografía cinematográfica de pantalla completa -->
  <img alt="Santiago y Daygrett" class="absolute inset-0 w-full h-full object-cover object-center scale-105 transform" src={heroImage.src} style="object-position: 50% 38%;" />
  <!-- Degradado fijo, más claro de abajo hacia arriba -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/25 to-transparent pointer-events-none"></div>
  <!-- Contenido editorial centrado -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto flex flex-col items-center justify-center">
    <p class="text-xs uppercase tracking-[0.35em] text-white/90 mb-4 font-sans font-light">
      Nos casamos
    </p>
    <!-- Nombres en serif de gran escala -->
    <h1 class="font-hero text-6xl sm:text-8xl md:text-9xl text-white font-light tracking-tight leading-[0.95] mb-6 drop-shadow-sm">
      Santiago <span class="font-sans text-4xl sm:text-6xl md:text-7xl text-brand-accent align-middle font-normal lowercase mx-2 sm:mx-4">&amp;</span> Daygrett
    </h1>
    <!-- Fecha y lugar -->
    <div class="flex items-center space-x-2 sm:space-x-3 text-xs sm:text-sm uppercase tracking-[0.15em] sm:tracking-[0.25em] text-white/90 font-light mt-2">
      <span>Sábado</span>
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
      <span>12 Diciembre 2026</span>
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
      <span>Turmero</span>
    </div>
  </div>
</section>
