<script is:inline>
  // Header scroll background effect
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      header.classList.remove('mix-blend-difference', 'text-white');
      header.classList.add('bg-white/95', 'backdrop-blur-md', 'text-brand-dark', 'shadow-sm', 'py-4');
    } else {
      header.classList.add('mix-blend-difference', 'text-white');
      header.classList.remove('bg-white/95', 'backdrop-blur-md', 'text-brand-dark', 'shadow-sm', 'py-4');
    }
  });
</script>
